PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/connectx
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE_MB=10
NODE_ENV=development
LOG_LEVEL=info

# Firebase Admin (Google OAuth)
FIREBASE_PROJECT_ID=connect-x-1af38
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative single-line base64 config:
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Email & SMTP Configuration (Brevo, Resend, SendGrid, MailHog, Gmail app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ConnectX <noreply@connectx.local>"
SUPPORT_EMAIL=support@connectx.local
APP_NAME=ConnectX
REQUIRE_EMAIL_VERIFICATION=false

# Account Security & Governance
ACCOUNT_DELETION_GRACE_DAYS=14
DATA_EXPORT_TTL_DAYS=7
MIN_AGE=16
REQUIRE_ADMIN_2FA=false
ENCRYPTION_KEY=
TURNSTILE_SECRET=

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@connectx.local"

# File Storage Configuration (local in dev, s3 in production)
STORAGE_PROVIDER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SEC=600

# Monitoring & Error Reporting
SENTRY_DSN_SERVER=

# AI Features (Google Gemini API)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
AI_MODEL_FAST=gemini-2.5-flash
AI_MODEL_SMART=gemini-2.5-pro

# Speech-to-Text (STT)
STT_PROVIDER=gemini
STT_MODEL=gemini-2.5-flash

# Vector Embeddings
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# AI Privacy & Retention
AI_RETENTION_DEFAULT_DAYS=90
PROVIDER_POLICY_URLS={"gemini":"https://ai.google.dev/terms","google":"https://policies.google.com/privacy"}
